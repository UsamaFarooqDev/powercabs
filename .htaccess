# Custom 404 page for any mistyped/missing URL. Requires Apache (or an
# Apache-compatible host) -- ErrorDocument is a core directive supported
# on virtually every standard PHP/shared host, no mod_rewrite needed.
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Normalize the homepage: /index or /index.php -> /
  RewriteRule ^index(\.php)?/?$ / [R=301,L,NE]

  # 1b) airport-transfers.php was renamed to meet-greet.php -- send anyone
  #     with the old URL bookmarked/indexed to the new one permanently.
  RewriteRule ^airport-transfers(\.php)?/?$ /meet-greet [R=301,L,NE]

  # 2) Anyone linking/bookmarking a URL with ".php" still in it gets sent to
  #    the clean, canonical version (301 = permanent, keeps SEO value and
  #    avoids duplicate-content indexing of both URL forms). Query strings
  #    are preserved automatically since the target has no "?".
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 3) A clean URL requested with a trailing slash (e.g. /drive/ instead of
  #    /drive) matches none of the rules above -- rule 4 below tests
  #    REQUEST_FILENAME + ".php", which for a trailing-slash request is
  #    ".../drive/.php" (the slash lands before the extension), so it never
  #    resolves. Canonicalize to the no-slash form unconditionally (any
  #    clean-URL path that isn't a real directory) rather than only when a
  #    matching .php file exists first -- a genuinely bad URL like
  #    /no-such-page/ still ends up on the same 404 either way, just via one
  #    harmless extra redirect instead of falling through unrewritten.
  #
  #    An earlier version of this rule pre-checked "%1.php -f" (does the
  #    no-slash target actually exist) before redirecting, chaining a
  #    RewriteCond backreference (%1) from one condition into a filesystem
  #    test in the next. That is standard mod_rewrite syntax on Apache, but
  #    is exactly the kind of construct that behaves differently on
  #    Apache-compatible-but-not-identical engines (LiteSpeed being the
  #    most common on shared PHP hosting) -- and matches this project's
  #    real symptom: /ride/ 500s live (an internal redirect/rewrite loop,
  #    per Apache's own definition of that error) while behaving correctly
  #    under the local dev server's from-scratch PHP reimplementation of
  #    these same rules (router.php), which never goes near mod_rewrite's
  #    condition-chaining at all. Dropping the pre-check removes that whole
  #    class of engine-specific fragility.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # 4) Internally serve the matching .php file for a clean URL -- the
  #    browser's address bar keeps showing the extension-less path.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [L]
</IfModule>
