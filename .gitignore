# Credentials -- never commit these. Copy .env.example to .env and fill
# in real values; .env.example itself is safe to commit (no secrets).
.env
.env.*
!.env.example

# No npm in this project -- no package.json, no lockfile, no node_modules, so
# nothing on the host can try to run a build. Tailwind is compiled with a
# one-off `npx` command (see CLAUDE.md) and its OUTPUT, assets/css/tailwind.css,
# is committed and served as a plain file. Never ignore that output.
node_modules/
