# PowerCabs website credentials template. Copy to .env and fill in real
# values -- .env itself is never committed.

# --- SMTP (outgoing mail for every form on the site) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="PowerCabs Website"
MAIL_TO=

# --- Google Maps JavaScript API ---
GOOGLE_MAPS_API_KEY=

# --- Supabase (shared backend with the PowerCabs Dispatcher/app --
#     pricing_config, ride_types, promo_codes).
#
#     None of these three has a fallback in includes/env.php, deliberately:
#     they used to, which is how the project URL and the anon key ended up
#     in git. Set them here or the features below degrade quietly.
#
#     SERVICE_KEY is a real secret -- server-side only, never rendered into
#     markup. Without it (or the URL) the fare calculator falls back to the
#     app's hard-coded day/night rates and no promo code will ever validate
#     (see lib/fare_calculator.php).
#
#     ANON_KEY is rendered into the page by reset-password.php, so it is
#     public by design and safe to expose -- but it still belongs here, not
#     in code, so it can be rotated without a deploy. Without it, password
#     recovery shows "temporarily unavailable". ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Stripe Payment Links (Stripe dashboard > Payment Links > Copy link) ---
#     Full https://buy.stripe.com/... URLs, one per thing a visitor pays for.
#     No Stripe API key is needed or used anywhere on the site.
#
#     The AMOUNT charged is whatever each link is set to inside Stripe -- the
#     pages only display a price. Keep each link's Stripe price equal to the
#     price its page shows (Meet & Greet: EUR10 one way / EUR18 both ways;
#     Lost item search: EUR15). Left empty, the page shows "online payment
#     unavailable" instead of a pay button.
STRIPE_MEET_GREET_LINK=
STRIPE_LOST_ITEM_LINK=
