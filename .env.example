# PowerCabs website credentials template. Copy to .env and fill in real
# values -- .env itself is never committed.

# --- SMTP (outgoing mail for every form on the site) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="PowerCabs Website"
MAIL_TO=

# --- Google Maps JavaScript API ---
GOOGLE_MAPS_API_KEY=

# --- Supabase (shared backend with the PowerCabs Dispatcher/app --
#     pricing_config, ride_types) -- fill these in for live fare pricing.
#     Until they're set, the fare calculator silently falls back to the
#     app's hard-coded day/night rates (see lib/fare_calculator.php). ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
